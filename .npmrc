# OMNIS pnpm configuration.
#
# engine-strict makes the `engines` contract in package.json enforceable rather
# than advisory: an install on an unsupported Node major fails immediately
# instead of producing a subtly broken build.
engine-strict=true

# Peer dependencies are installed automatically so workspace members do not have
# to re-declare React, Zod and friends they only consume transitively.
auto-install-peers=true

# A transitive peer *warning* must not be able to fail a clean install; genuine
# incompatibilities are still surfaced in the install log and by typecheck.
strict-peer-dependencies=false

# Workspace links are written as `workspace:*` so published artifacts get real
# version ranges.
save-workspace-protocol=rolling

# pnpm re-verifies (and can re-resolve) the whole workspace before every single
# `pnpm run`, which added several seconds to each Turbo task. The lockfile is
# verified once by `pnpm install`, which CI runs explicitly.
verify-deps-before-run=false
