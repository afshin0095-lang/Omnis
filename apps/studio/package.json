{
  "name": "studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "OMNIS Studio - the operator surface for the AI operating system: characters, content factory, publishing and analytics.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint src vite.config.ts vitest.config.ts --max-warnings=0",
    "test": "vitest run",
    "preview": "vite preview",
    "clean": "node ../../scripts/clean-package.mjs dist"
  },
  "dependencies": {
    "@omnis/errors": "workspace:*",
    "@omnis/theme": "workspace:*",
    "@omnis/ui": "workspace:*",
    "clsx": "catalog:",
    "framer-motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
