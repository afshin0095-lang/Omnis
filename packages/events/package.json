{
  "name": "@omnis/events",
  "version": "0.1.0",
  "private": true,
  "description": "The OMNIS event contract foundation: versioned event type registry, definitions and a local in-memory bus.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "clean": "node ../../scripts/clean-package.mjs"
  },
  "dependencies": {
    "@omnis/contracts": "workspace:*",
    "@omnis/errors": "workspace:*",
    "@omnis/types": "workspace:*",
    "@omnis/validation": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
