{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src"],
  // Tests and their doubles are typechecked by tsconfig.json but never shipped in dist.
  "exclude": ["src/**/*.test.ts", "src/testSupport.ts"]
}
