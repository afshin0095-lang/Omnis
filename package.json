{
  "name": "omnis",
  "version": "0.1.0",
  "private": true,
  "description": "OMNIS — AI Operating System, Agent OS, Digital Human OS, Content Factory, Audience Intelligence and Growth Platform.",
  "license": "MIT",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:workspace": "node scripts/check-workspace-health.mjs",
    "verify:secrets": "node scripts/scan-secrets.mjs",
    "verify": "pnpm verify:workspace && pnpm verify:secrets",
    "check": "pnpm verify && turbo run lint typecheck test build",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
